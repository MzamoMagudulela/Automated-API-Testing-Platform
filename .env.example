# API TestLab - Environment Configuration Template

# Server Settings
PROJECT_NAME="API TestLab"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (SQLite by default, or PostgreSQL)
DATABASE_URL="sqlite:///./api_testlab.db"
# Example PostgreSQL:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/api_testlab"

# Security & SSRF Defense Settings
# Set to true for local testing with mock/localhost endpoints
ALLOW_PRIVATE_IPS=true

# Execution Controls
DEFAULT_TIMEOUT_SECONDS=30.0
MAX_TIMEOUT_SECONDS=120.0
MAX_RESPONSE_SIZE_BYTES=10485760

# Frontend Development Server
VITE_API_URL="http://localhost:8000"
